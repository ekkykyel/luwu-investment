<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 1600 900" width="1600" height="900">
  <defs>
    <linearGradient id="heroBg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" stop-color="#061727"/>
      <stop offset="50%" stop-color="#0A2238"/>
      <stop offset="100%" stop-color="#0F2D4A"/>
    </linearGradient>
    <linearGradient id="accentGrad" x1="0%" y1="0%" x2="100%" y2="0%">
      <stop offset="0%" stop-color="#059669"/>
      <stop offset="50%" stop-color="#10B981"/>
      <stop offset="100%" stop-color="#34D399"/>
    </linearGradient>
    <radialGradient id="glow" cx="50%" cy="40%" r="60%">
      <stop offset="0%" stop-color="#10B981" stop-opacity="0.25"/>
      <stop offset="100%" stop-color="#0A2238" stop-opacity="0"/>
    </radialGradient>
    <pattern id="grid" width="40" height="40" patternUnits="userSpaceOnUse">
      <path d="M 40 0 L 0 0 0 40" fill="none" stroke="#ffffff" stroke-width="0.75" stroke-opacity="0.04"/>
    </pattern>
  </defs>

  <rect width="1600" height="900" fill="url(#heroBg)"/>
  <rect width="1600" height="900" fill="url(#glow)"/>
  <rect width="1600" height="900" fill="url(#grid)"/>

  <!-- Building / Architecture Stylized Silhouette -->
  <g opacity="0.12" fill="#ffffff">
    <rect x="250" y="320" width="1100" height="380" rx="16"/>
    <rect x="320" y="240" width="960" height="100" rx="8"/>
    <polygon points="800,140 280,240 1320,240"/>
    <rect x="420" y="400" width="60" height="180" rx="4"/>
    <rect x="540" y="400" width="60" height="180" rx="4"/>
    <rect x="660" y="400" width="60" height="180" rx="4"/>
    <rect x="770" y="440" width="60" height="260" rx="4"/>
    <rect x="880" y="400" width="60" height="180" rx="4"/>
    <rect x="1000" y="400" width="60" height="180" rx="4"/>
    <rect x="1120" y="400" width="60" height="180" rx="4"/>
  </g>

  <!-- Modern Civic Geometric Lines -->
  <line x1="200" y1="700" x2="1400" y2="700" stroke="url(#accentGrad)" stroke-width="4" stroke-opacity="0.6"/>
  <circle cx="800" cy="400" r="160" fill="none" stroke="url(#accentGrad)" stroke-width="1.5" stroke-opacity="0.3"/>
  <circle cx="800" cy="400" r="220" fill="none" stroke="url(#accentGrad)" stroke-width="1" stroke-dasharray="6,6" stroke-opacity="0.2"/>

  <!-- Center Crest Symbol -->
  <g transform="translate(800, 370)">
    <circle cx="0" cy="0" r="54" fill="#0F2D4A" stroke="#10B981" stroke-width="3"/>
    <path d="M-22,-6 L0,-28 L22,-6 L14,24 L-14,24 Z" fill="none" stroke="#34D399" stroke-width="2.5" stroke-linejoin="round"/>
    <circle cx="0" cy="2" r="6" fill="#10B981"/>
  </g>

  <!-- Typography watermark -->
  <text x="800" y="520" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="28" font-weight="800" letter-spacing="4" fill="#E2E8F0">
    MAL PELAYANAN PUBLIK
  </text>
  <text x="800" y="555" text-anchor="middle" font-family="system-ui, -apple-system, sans-serif" font-size="16" font-weight="600" letter-spacing="6" fill="#10B981">
    SIMPURUSIANG KABUPATEN LUWU
  </text>
</svg>
