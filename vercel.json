{
  "version": 2,
  "framework": "vite",
  "installCommand": "npm install --legacy-peer-deps",
  "buildCommand": "npm run build",
  "functions": {
    "api/[...all].ts": {
      "maxDuration": 15
    },
    "api/gemini/chat.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/gemini/chat",
      "destination": "/api/gemini/chat"
    },
    {
      "source": "/gemini/(.*)",
      "destination": "/api/gemini/chat"
    },
    {
      "source": "/api/gemini/chat",
      "destination": "/api/gemini/chat"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/[...all]"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
